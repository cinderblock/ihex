{
  "name": "ihex",
  "version": "1.0.0",
  "description": "Parse Intel HEX files and load them into a Buffer. Zero runtime dependencies, ESM, TypeScript types.",
  "type": "module",
  "main": "dist/ihex.js",
  "types": "dist/ihex.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ihex.d.ts",
      "default": "./dist/ihex.js"
    }
  },
  "files": [
    "dist/ihex.js",
    "dist/ihex.js.map",
    "dist/ihex.d.ts",
    "dist/ihex.d.ts.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/ihex.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/ihex.git"
  },
  "keywords": [
    "intel-hex",
    "ihex",
    "hex",
    "binary",
    "firmware",
    "avr",
    "parser",
    "embedded"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cinderblock/ihex/issues"
  },
  "homepage": "https://github.com/cinderblock/ihex#readme",
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  }
}
